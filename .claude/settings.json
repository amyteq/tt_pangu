{
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(python -m pytest*)",
      "Bash(pytest*)",
      "Bash(ruff check*)",
      "Bash(ruff format*)",
      "Bash(npm test*)",
      "Bash(npm run test*)",
      "Bash(npm run lint*)",
      "Bash(make test*)",
      "Bash(make lint*)"
    ],
    "ask": [
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(kaggle competitions submit*)",
      "Bash(kaggle kernels push*)",
      "Bash(supabase db push*)",
      "Bash(supabase migration up*)",
      "Bash(docker*)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./kaggle.json)",
      "Read(./**/kaggle.json)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Edit(./.env*)",
      "Edit(./secrets/**)",
      "Bash(git push --force*)",
      "Bash(rm -rf / *)",
      "Bash(rm -rf ~*)",
      "Bash(sudo*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": false,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": ["~/.ssh", "~/.aws", "~/.config/gcloud"],
      "denyWrite": ["/", "/etc", "/usr", "/var", "~/.ssh", "~/.aws", "~/.config/gcloud"],
      "allowWrite": [".", "/tmp"]
    },
    "network": {
      "allowedDomains": [
        "api.anthropic.com",
        "claude.ai",
        "github.com",
        "raw.githubusercontent.com",
        "kaggle.com",
        "*.kaggle.com",
        "supabase.co",
        "*.supabase.co",
        "pypi.org",
        "files.pythonhosted.org",
        "registry.npmjs.org",
        "playwright.dev"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard_tool.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/audit_event.py"
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "matcher": "project_settings|skills",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/audit_event.py"
          }
        ]
      }
    ]
  }
}
