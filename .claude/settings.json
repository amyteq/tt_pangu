{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read",
      "Edit",
      "Write",
      "MultiEdit",
      "Glob",
      "Grep",
      "LS",
      "NotebookRead",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Bash",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(python -m pytest*)",
      "Bash(pytest*)",
      "Bash(ruff check*)",
      "Bash(ruff format*)",
      "Bash(npm test*)",
      "Bash(npm run test*)",
      "Bash(npm run lint*)",
      "Bash(make test*)",
      "Bash(make lint*)",
      "Bash(python tools/kca/kca.py nb*)",
      "Bash(python tools/kca/kca.py run init*)",
      "Bash(python tools/kca/kca.py run record-metric*)",
      "Bash(python tools/kca/kca.py run list*)",
      "Bash(python tools/kca/kca.py eval*)",
      "Bash(python tools/kca/kca.py kaggle watch*)",
      "Bash(python tools/kca/kca.py kaggle fetch*)",
      "Bash(python tools/kca/kca.py kaggle list*)",
      "Bash(python tools/legacy/nb2py.py*)",
      "Bash(python tools/legacy/py2nb.py*)",
      "Bash(python tools/legacy/nb2test.py*)",
      "Bash(python tools/legacy/nb2md.py*)",
      "Bash(mkdir *)",
      "Bash(uv --version)",
      "Bash(pnpm --version)",
      "Bash(npm --version)",
      "Bash(python -m pytest tests/test_kca_smoke*)",
      "Bash(python scripts/run_job.py*)",
      "Bash(python -c*)",
      "Bash(python tools/kca/kca.py workspace*)",
      "Bash(python tools/kca/kca.py decisions*)",
      "Bash(git worktree*)",
      "Bash(psql*)",
      "Bash(grep -r*)"
    ],
    "ask": [
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(supabase db push*)",
      "Bash(supabase migration up*)",
      "Bash(docker*)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "Bash(python tools/kca/kca.py kaggle submit*)",
      "Bash(python tools/kca/kca.py kaggle push*)",
      "Bash(python tools/kca/kca.py kaggle upload*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./.env.test)",
      "Read(./kaggle.json)",
      "Read(./.kaggle/kaggle.json)",
      "Read(~/.kaggle/kaggle.json)",
      "Read(./secrets/**)",
      "Read(./**/kaggle.json)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Edit(./.env*)",
      "Edit(./secrets/**)",
      "Bash(git push --force*)",
      "Bash(rm -rf / *)",
      "Bash(rm -rf ~*)",
      "Bash(sudo*)",
      "Bash(kaggle competitions submit*)",
      "Bash(kaggle kernels push*)",
      "Bash(kaggle datasets create*)",
      "Bash(kaggle datasets version*)",
      "Bash(python tools/legacy/kkr.py submit*)",
      "Bash(python tools/legacy/kkr.py push*)",
      "Bash(tools/legacy/kkr.py submit*)",
      "Bash(tools/legacy/kkr.py push*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": false,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,
    "filesystem": {
      "denyRead": ["~/.ssh", "~/.aws", "~/.config/gcloud"],
      "denyWrite": ["/", "/etc", "/usr", "/var", "~/.ssh", "~/.aws", "~/.config/gcloud"],
      "allowWrite": [".", "/tmp"]
    },
    "network": {
      "allowedDomains": [
        "api.anthropic.com",
        "claude.ai",
        "github.com",
        "raw.githubusercontent.com",
        "kaggle.com",
        "*.kaggle.com",
        "supabase.co",
        "*.supabase.co",
        "pypi.org",
        "files.pythonhosted.org",
        "registry.npmjs.org",
        "playwright.dev"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard_tool.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/audit_event.py"
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "matcher": "project_settings|skills",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/audit_event.py"
          }
        ]
      }
    ]
  }
}
