{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read",
      "Edit",
      "Write",
      "MultiEdit",
      "Glob",
      "Grep",
      "LS",
      "NotebookRead",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Bash",
      "Agent(Explore)",
      "Agent(Plan)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git rebase*)",
      "Bash(git merge*)",
      "Bash(git worktree*)",
      "Bash(gh issue list*)",
      "Bash(gh issue view*)",
      "Bash(gh issue create*)",
      "Bash(gh issue edit*)",
      "Bash(gh issue comment*)",
      "Bash(gh issue close*)",
      "Bash(gh issue reopen*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr status*)",
      "Bash(gh pr create*)",
      "Bash(gh pr edit*)",
      "Bash(gh pr comment*)",
      "Bash(gh pr close*)",
      "Bash(gh pr reopen*)",
      "Bash(gh pr ready*)",
      "Bash(gh pr merge*)",
      "Bash(gh label list*)",
      "Bash(gh label create*)",
      "Bash(gh label edit*)",
      "Bash(gh label clone*)",
      "Bash(gh release create*)",
      "Bash(gh release edit*)",
      "Bash(gh api*)",
      "Bash(gh repo view*)",
      "Bash(uv*)",
      "Bash(python*)",
      "Bash(pytest*)",
      "Bash(ruff*)",
      "Bash(pyright*)",
      "Bash(mypy*)",
      "Bash(make*)",
      "Bash(npm*)",
      "Bash(pnpm*)",
      "Bash(npx*)",
      "Bash(node*)",
      "Bash(vite*)",
      "Bash(docker*)",
      "Bash(docker compose*)",
      "Bash(supabase status*)",
      "Bash(supabase start*)",
      "Bash(supabase stop*)",
      "Bash(supabase migration*)",
      "Bash(supabase migration up*)",
      "Bash(supabase db diff*)",
      "Bash(supabase gen types*)",
      "Bash(psql*)",
      "Bash(sqlite3*)",
      "Bash(mkdir*)",
      "Bash(touch*)",
      "Bash(cp*)",
      "Bash(mv*)",
      "Bash(chmod +x*)",
      "Bash(python tools/kca/kca.py*)",
      "Bash(python scripts/run_job.py*)",
      "Bash(scripts/*)",
      "Bash(kaggle competitions submit*)",
      "Bash(python tools/kca/kca.py kaggle submit*)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(git clean*)",
      "Bash(supabase db push*)",
      "Bash(supabase db reset*)",
      "Bash(kaggle kernels push*)",
      "Bash(kaggle datasets create*)",
      "Bash(kaggle datasets version*)",
      "Bash(python tools/kca/kca.py kaggle push*)",
      "Bash(python tools/kca/kca.py kaggle upload*)",
      "Bash(kca ctf flag submit*)",
      "Bash(kca ctf solver run*)",
      "Bash(python tools/kca/kca.py ctf flag submit*)",
      "Bash(python tools/kca/kca.py ctf solver run*)"
    ],
    "deny": [
      "Read(./.env.production)",
      "Read(./.env.test)",
      "Read(./secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.config/gh/hosts.yml)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.development)",
      "Edit(./.env.production)",
      "Edit(./.env.test)",
      "Edit(./secrets/**)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.config/gcloud/**)",
      "Bash(sudo*)",
      "Bash(su *)",
      "Bash(doas*)",
      "Bash(rm -rf / *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf $HOME*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --delete*)",
      "Bash(git push --delete*)",
      "Bash(git push * :*)",
      "Bash(docker run *--privileged*)",
      "Bash(chmod 777*)",
      "Bash(chown * / *)",
      "Bash(mkfs*)",
      "Bash(dd *of=/dev*)",
      "Bash(shutdown*)",
      "Bash(reboot*)",
      "Bash(halt*)",
      "Bash(gh issue delete*)",
      "Bash(gh label delete*)",
      "Bash(gh release delete*)",
      "Bash(gh repo delete*)",
      "Bash(gh secret delete*)",
      "Bash(gh webhook delete*)",
      "Bash(gh ssh-key delete*)",
      "Bash(gh gpg-key delete*)",
      "Bash(gh cache delete*)",
      "Bash(gh run delete*)",
      "Bash(gh extension remove*)",
      "Bash(curl *169.254.169.254*)",
      "Bash(wget *169.254.169.254*)",
      "Bash(curl *metadata.google*)",
      "Bash(wget *metadata.google*)",
      "Bash(psql * -c *drop database*)",
      "Bash(psql * -c *drop schema*)",
      "Bash(psql * -c *truncate*)",
      "Bash(psql * -c *delete from*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": false,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,
    "filesystem": {
      "denyRead": [
        "~/.aws",
        "~/.config/gcloud",
        "~/.config/gh/hosts.yml"
      ],
      "denyWrite": [
        "/",
        "/etc",
        "/usr",
        "/var",
        "~/.ssh",
        "~/.aws",
        "~/.config/gcloud",
        "~/.config/gh"
      ],
      "allowWrite": [
        ".",
        "/tmp"
      ]
    },
    "network": {
      "allowedDomains": [
        "api.anthropic.com",
        "claude.ai",
        "github.com",
        "api.github.com",
        "raw.githubusercontent.com",
        "objects.githubusercontent.com",
        "kaggle.com",
        "*.kaggle.com",
        "supabase.co",
        "*.supabase.co",
        "pypi.org",
        "files.pythonhosted.org",
        "registry.npmjs.org",
        "playwright.dev",
        "localhost",
        "127.0.0.1"
      ],
      "deniedDomains": [
        "169.254.169.254",
        "metadata.google"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard_tool.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format_gate.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/audit_event.py"
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "matcher": "project_settings|skills",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/audit_event.py"
          }
        ]
      }
    ]
  }
}
